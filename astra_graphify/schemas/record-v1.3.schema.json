{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra-graphify/record-v1.3",
  "title": "ASTRA Graphify content record v1.3 (node or edge). Provenance is validated separately with provenance-v1.2.schema.json.",
  "type": "object",
  "required": ["id", "project_id", "kind", "knowledge_layer"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "kind": {"enum": ["node", "edge"]},
    "knowledge_layer": {"enum": ["SOURCE", "EXTRACTED", "INFERRED", "VERIFIED", "REJECTED"]},
    "label": {"type": "string", "maxLength": 512},
    "node_type": {"enum": ["FILE", "SYMBOL", "SECTION", "EXTERNAL"]},
    "source_file": {"type": "string", "maxLength": 1024},
    "snippet": {"type": "string", "maxLength": 2000},
    "source": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "relation": {"type": "string", "minLength": 1, "maxLength": 80}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "node"}}},
      "then": {
        "required": ["label", "node_type"],
        "not": {"anyOf": [{"required": ["source"]}, {"required": ["target"]}, {"required": ["relation"]}]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "edge"}}},
      "then": {
        "required": ["source", "target", "relation"],
        "not": {"anyOf": [{"required": ["node_type"]}, {"required": ["snippet"]}]}
      }
    }
  ]
}
