{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_id",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_url",
        "sha256",
        "updated_at_utc",
        "verification_status"
      ],
      "properties": {
        "source_url": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "updated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "verification_status": {
          "enum": [
            "UNVERIFIED",
            "VERIFIED",
            "REJECTED"
          ]
        },
        "locator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "enum": [
            "ACTUAL",
            "DESIGN",
            "NOT_TESTED"
          ]
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "relation",
        "evidence",
        "source"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "evidence": {
          "enum": [
            "EXTRACTED",
            "INFERRED",
            "MANUAL"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    }
  }
}